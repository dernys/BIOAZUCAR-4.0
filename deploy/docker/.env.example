# ==============================================================================
# BIOAZÚCAR 4.0 — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Security Notice: Do not commit actual secrets to version control.
# Copy this file to .env and adjust variables for the targeted installation.

# 1. APPLICATION & NETWORK
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
BIOAZUCAR_VERSION=4.0.0-prod
BIOAZUCAR_SECURITY_PROFILE=PRODUCTION
BIOAZUCAR_TENANT_ID=TENANT_AZUCAR_01
BIOAZUCAR_SITE_ID=CENTRAL_PROV_01

# 2. PERSISTENT STORAGE
BIOAZUCAR_DATA_DIR=/app/data
BIOAZUCAR_LOG_DIR=/app/logs
BIOAZUCAR_BACKUP_DIR=/app/backup
BIOAZUCAR_SQLITE_WAL=true

# 3. EDGE & STORE-AND-FORWARD
BIOAZUCAR_EDGE_ID=edge-node-tandem-1
BIOAZUCAR_EDGE_SECRET=replace_with_strong_random_secret_minimum_32_characters
BIOAZUCAR_CLOUD_URL=http://application:3000/api/edge/telemetry-sync
BIOAZUCAR_SYNC_INTERVAL_MS=2000
BIOAZUCAR_HEARTBEAT_MS=10000
BIOAZUCAR_BATCH_SIZE=100
BIOAZUCAR_EDGE_HEALTH_PORT=9099
BIOAZUCAR_SAF_JOURNAL_PATH=/var/lib/bioazucar-edge/saf-journal.json

# 4. INDUSTRIAL BROKER & FIELD PROTOCOLS
BIOAZUCAR_MQTT_BROKER_URL=mqtt://broker:1883
BIOAZUCAR_OPCUA_ENDPOINT=opc.tcp://192.168.10.10:4840
BIOAZUCAR_MODBUS_HOST=192.168.10.20
BIOAZUCAR_MODBUS_PORT=502

# 5. SECURITY & ASYMMETRIC PROVISIONING
BIOAZUCAR_PROVISIONING_PUBKEY_PATH=/app/certs/provisioning-public.pem
BIOAZUCAR_TLS_CA_CERT=/app/certs/ca.crt
BIOAZUCAR_TLS_SERVER_CERT=/app/certs/server.crt
BIOAZUCAR_TLS_SERVER_KEY=/app/certs/server.key

# 6. AI & EXTERNAL INTEGRATIONS (OPTIONAL)
GEMINI_API_KEY=
