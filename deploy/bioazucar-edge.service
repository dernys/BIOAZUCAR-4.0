[Unit]
Description=BioAzúcar 4.0 Industrial Edge Gateway Daemon (IEC 62443 L2/L3)
After=network.target network-online.target
Wants=network-online.target
Documentation=https://github.com/dernys/BIOAZUCAR-4.0#readme

[Service]
Type=simple
User=otuser
Group=otgroup
WorkingDirectory=/opt/bioazucar-edge
EnvironmentFile=-/etc/bioazucar/edge.env
ExecStart=/usr/bin/node /opt/bioazucar-edge/edge-daemon.cjs
Restart=always
RestartSec=5s
KillMode=process
TimeoutStopSec=15s

# Process and resource limits for Industrial PCs (Advantech / Siemens)
LimitNOFILE=65536
MemoryMax=512M
CPUQuota=150%

# IEC 62443-4-2 Operating System Hardening
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/bioazucar-edge /var/log/bioazucar /opt/bioazucar-edge/data

# Logging to standard systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bioazucar-edge

[Install]
WantedBy=multi-user.target
