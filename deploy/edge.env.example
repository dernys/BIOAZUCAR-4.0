# ==============================================================================
# BIOAZÚCAR 4.0 — INDUSTRIAL EDGE DAEMON CONFIGURATION (.env)
# ==============================================================================
# Place this file at /etc/bioazucar/edge.env on the Industrial PC (IPC)
# Ensure file permissions are set to 0600 (chmod 600 /etc/bioazucar/edge.env)

NODE_ENV=production

# ------------------------------------------------------------------------------
# Identity & Tenant Identification
# ------------------------------------------------------------------------------
BIOAZUCAR_TENANT_ID=TENANT_AZUCAR_01
BIOAZUCAR_EDGE_ID=edge-node-tandem-1
BIOAZUCAR_SITE_ID=SITE_CENTRAL_01

# ------------------------------------------------------------------------------
# Cloud Synchronization & Cryptographic Authentication (IEC 62443-4-2 SL3)
# ------------------------------------------------------------------------------
# Target cloud endpoint for telemetry ingestion
BIOAZUCAR_CLOUD_URL=https://api.bioazucar40.com/api/edge/telemetry-sync

# Shared symmetric HMAC-SHA256 secret (Minimum 32 random characters)
BIOAZUCAR_EDGE_SECRET=replace_with_a_secure_random_64_character_hex_secret_here

# Transmission intervals
BIOAZUCAR_SYNC_INTERVAL_MS=2000
BIOAZUCAR_HEARTBEAT_MS=10000
BIOAZUCAR_BATCH_SIZE=100

# ------------------------------------------------------------------------------
# Resilience & Data-At-Rest Encryption (Store & Forward)
# ------------------------------------------------------------------------------
# Path to local persistent journal file on SSD / NVMe
BIOAZUCAR_SAF_JOURNAL_PATH=/var/lib/bioazucar-edge/saf-journal.json

# Optional AES-256-GCM encryption key for un-forwarded telemetry on disk
# When defined, the journal file is encrypted before writing to protect plant IP
BIOAZUCAR_DISK_ENCRYPTION_KEY=replace_with_32_byte_aes_key_for_storage_encryption

# ------------------------------------------------------------------------------
# Network Topology & Dual-NIC Isolation (ISA-95 L2 vs L3 DMZ)
# ------------------------------------------------------------------------------
# Physical interface connected to isolated PLC/DCS network (e.g., 192.168.10.x)
BIOAZUCAR_OT_IFACE=eth0

# Physical interface connected to Plant DMZ / Cloud outbound internet (e.g., 10.0.0.x)
BIOAZUCAR_DMZ_IFACE=eth1

# ------------------------------------------------------------------------------
# Transport Layer Security (mTLS / TLS 1.3)
# ------------------------------------------------------------------------------
# Optional client certificates for mutual TLS
# BIOAZUCAR_TLS_CA_CERT=/etc/bioazucar/certs/plant-ca.crt
# BIOAZUCAR_TLS_CLIENT_CERT=/etc/bioazucar/certs/edge-client.crt
# BIOAZUCAR_TLS_CLIENT_KEY=/etc/bioazucar/certs/edge-client.key
BIOAZUCAR_TLS_INSECURE=false

# ------------------------------------------------------------------------------
# Local Health Watchdog Port
# ------------------------------------------------------------------------------
# HTTP watchdog endpoint for systemd / Nagios / Prometheus health checking
BIOAZUCAR_EDGE_HEALTH_PORT=9099
