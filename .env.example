# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPERADMIN_EMAIL / VITE_SUPERADMIN_EMAIL: Authorized Root / Super Administrator email for global multi-tenant access (IEC 62443 SL3)
SUPERADMIN_EMAIL="ing.dernys@gmail.com"
VITE_SUPERADMIN_EMAIL="ing.dernys@gmail.com"

# SUPERADMIN_PASSWORD / VITE_SUPERADMIN_PASSWORD: Root / Super Administrator password for development and testing environments.
# In PRODUCTION, the application mandates explicit creation or interactive prompt/migration of the production password.
SUPERADMIN_PASSWORD="BioAzucarSuperAdmin2026!#Dev"
VITE_SUPERADMIN_PASSWORD="BioAzucarSuperAdmin2026!#Dev"
